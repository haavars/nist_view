{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NIST Viewer",
  "mainBinaryName": "nist-viewer",
  "version": "0.2.0",
  "identifier": "io.github.haavars.nistview",
  "build": {
    "beforeBuildCommand": "mix desktop.release",
    "beforeDevCommand": "mkdir -p src-tauri/target/rel"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Viewer for ANSI/NIST-ITL transaction files",
    "longDescription": "Opens ANSI/NIST-ITL transactions (.an2, .nst, .eft) and shows every record, field and image, with minutiae overlays. Files are read into memory only.",
    "resources": {
      "target/rel": "rel"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["an2", "nst", "eft", "nist"],
        "name": "ANSI/NIST-ITL transaction",
        "description": "ANSI/NIST-ITL biometric transaction",
        "role": "Viewer",
        "mimeType": "application/octet-stream"
      }
    ],
    "macOS": {
      "entitlements": "App.entitlements",
      "minimumSystemVersion": "11.0"
    }
  }
}

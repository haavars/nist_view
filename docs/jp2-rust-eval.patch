+        // A zero for a coefficient that is not significant yet changes nothing.
+        if bit == 0 && self.0 & 0x7FFF_FFFF == 0 {
+            return;
+        }
+        let mask = 1_u32 << (position + 1);
+        self.0 = (self.0 & !mask) | (bit << (position + 1)) | (1 << position);
     }
